{
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "semi": true,
  "htmlWhitespaceSensitivity": "ignore",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/styles/components/globals.css",
  "tailwindFunctions": ["cn"],
  "overrides": [
    {
      "files": ["*.html"],
      "options": {
        "printWidth": 120
      }
    }
  ]
}
