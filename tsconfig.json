{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "peakflow": [
        "../../peakflow/src/index.ts"
      ],
      "peakflow/*": [
        "../../peakflow/src/*"
      ]
    },
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "declaration": true,
    "noEmit": true,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "./src",
    "./*.config.ts"
  ],
  "exclude": [
    "./dist",
    "./node_modules"
  ]
}